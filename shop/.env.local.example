# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git

# Lemon Squeezy — https://app.lemonsqueezy.com/settings/api
LEMONSQUEEZY_API_KEY=

# Your store ID — https://app.lemonsqueezy.com/settings/stores
LEMONSQUEEZY_STORE_ID=

# Webhook secret — set when creating webhook in LS dashboard
# Webhook URL: https://your-domain.com/api/webhook
LEMONSQUEEZY_WEBHOOK_SECRET=

# Variant IDs — found on each product's variant page in LS dashboard
LS_VARIANT_FREELANCER_CRM=
LS_VARIANT_SOLOPRENEUR_OS=
LS_VARIANT_AI_PROMPTS=
LS_VARIANT_SOP_PACK=

# Your deployed URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://your-store.vercel.app
